%YAML 1.2
---
# One grammar covers postgresql.conf, postgresql.auto.conf, pg_hba.conf and
# pg_ident.conf. The line shapes do not overlap: a rule starts with a
# connection type, a user map has three bare fields and no equals sign, and
# anything else is a setting.
# No file extensions: the files are found by name, which the bundle's plugin
# registers.
name: PostgreSQL Config
scope: source.postgresql-conf

variables:
  ident: "[A-Za-z_][A-Za-z0-9_]*"
  bare: '[^\s=#]+'

contexts:
  main:
    - include: comment
    - include: directive
    - include: hba-rule
    - include: ident-map
    - include: setting

  comment:
    - match: "#.*$"
      scope: comment.line.number-sign.postgresql-conf

  # include, include_if_exists and include_dir; postgresql.conf allows an
  # equals sign between the directive and the file name, pg_hba.conf does not.
  directive:
    - match: '^\s*(include_if_exists|include_dir|include)\b'
      captures:
        1: keyword.control.import.postgresql-conf
      push: directive-value

  directive-value:
    - match: "="
      scope: keyword.operator.assignment.postgresql-conf
    - include: comment
    - include: quoted
    - match: '\S+'
      scope: string.unquoted.postgresql-conf
    - match: "$"
      pop: true

  hba-rule:
    - match: '^\s*(local|hostssl|hostnossl|hostgssenc|hostnogssenc|host)\b'
      captures:
        1: keyword.other.connection-type.postgresql-conf
      push: hba-fields

  hba-fields:
    - include: comment
    - match: '\b(trust|reject|scram-sha-256|md5|password|gss|sspi|ident|peer|ldap|radius|cert|pam|bsd|oauth)\b'
      scope: support.type.auth-method.postgresql-conf
    - match: '\b(all|sameuser|samerole|samegroup|replication|samehost|samenet)\b'
      scope: constant.language.postgresql-conf
    - match: '(?<!\S)(?:(?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?|[0-9a-fA-F:]*::[0-9a-fA-F:]*(?:/\d{1,3})?)(?!\S)'
      scope: constant.numeric.address.postgresql-conf
    - match: '"[^"]*"'
      scope: string.quoted.double.postgresql-conf
    - match: "({{ident}})(=)"
      captures:
        1: variable.parameter.option.postgresql-conf
        2: keyword.operator.assignment.postgresql-conf
    - match: "$"
      pop: true

  # pg_ident.conf: map name, system user (a name or a regular expression),
  # database user.
  ident-map:
    - match: '^\s*({{ident}})\s+({{bare}})\s+({{bare}})\s*(?=#|$)'
      captures:
        1: entity.name.tag.map.postgresql-conf
        2: string.unquoted.system-user.postgresql-conf
        3: variable.other.database-user.postgresql-conf

  # postgresql.conf: the equals sign is optional.
  setting:
    - match: '^\s*({{ident}}(?:\.{{ident}})*)\s*(=)?'
      captures:
        1: variable.other.setting.postgresql-conf
        2: keyword.operator.assignment.postgresql-conf
      push: value

  value:
    - match: "(?=#)"
      pop: true
    - include: quoted
    - match: '\b-?\d+(?:\.\d+)?\s*(?:kB|MB|GB|TB|us|ms|s|min|h|d|B)?\b'
      scope: constant.numeric.postgresql-conf
    - match: '\b(?i:on|off|true|false|yes|no)\b'
      scope: constant.language.boolean.postgresql-conf
    - match: "[A-Za-z_][A-Za-z0-9_./:-]*"
      scope: string.unquoted.postgresql-conf
    - match: "$"
      pop: true

  quoted:
    - match: "'(?:[^']|'')*'"
      scope: string.quoted.single.postgresql-conf
